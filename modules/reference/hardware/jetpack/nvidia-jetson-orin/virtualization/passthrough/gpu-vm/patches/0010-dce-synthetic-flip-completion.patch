@@ -4292,11 +4292,25 @@
 static void CompletionNotifierEvent(void *arg, void *pEventDataVoid,
                                     NvU32 hEvent, NvU32 Data, NV_STATUS Status)
 {
+  /* dce: the host DCE R5 posts this flip-completion event ~130ms after
+   * the kickoff, capping flips at ~8-10fps. Drop it; deliver the
+   * completion from nvDceScheduleSyntheticFlipOccurred() instead. */
+  (void) arg;
+}
+
+void nvDceScheduleSyntheticFlipOccurred(NVEvoChannelPtr pChannel)
+{
+  /* Caller schedules this for the primary (main) layer only: the overlay
+   * layer carries no framebuffer in this passthrough and completing it
+   * triggers WARN_ON(process_pending) in nvidia-drm (the layer-1 flood). */
+  if (pChannel == NULL || pChannel->completionNotifierEventRefPtr == NULL) {
+      return;
+  }
   (void) nvkms_alloc_timer_with_ref_ptr(
-        CompletionNotifierEventDeferredWork, /* callback */
-        arg, /* argument (this is a ref_ptr to NVDispFlipOccurredEventDataEvoRec) */
-        0,   /* dataU32 */
-        0);  /* timeout: schedule the work immediately */
+        CompletionNotifierEventDeferredWork,
+        (struct nvkms_ref_ptr *) pChannel->completionNotifierEventRefPtr,
+        0,
+        11000 /* usec: HZ=250 truncates to 2 jiffies (~4-8ms) */);
 }
 
