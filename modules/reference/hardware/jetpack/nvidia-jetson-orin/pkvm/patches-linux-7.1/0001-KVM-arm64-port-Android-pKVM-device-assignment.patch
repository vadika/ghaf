+	.release = pviommufd_release,
+	.llseek = noop_llseek,
+};
+
+static int kvm_vfio_pviommu_attach(struct kvm_device *dev)
+{
+	struct kvm_pviommu *pviommu;
+	struct file *file;
+	int fd;
+	int ret;
+
+	if (!kvm_vm_is_protected(dev->kvm))
+		return -EINVAL;
+
+	pviommu = kzalloc_obj(*pviommu, GFP_KERNEL_ACCOUNT);
+	if (!pviommu)
+		return -ENOMEM;
+
+	pviommu->kvm = dev->kvm;
+	kvm_get_kvm(dev->kvm);
+
+	file = anon_inode_getfile("kvm-pviommu", &pviommu_fops, pviommu,
+				  O_CLOEXEC);
+	if (IS_ERR(file)) {
+		ret = PTR_ERR(file);
+		goto out_put_kvm;
+	}
+
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0) {
+		ret = fd;
+		goto out_fput;
+	}
+
+	ret = kvm_call_hyp_nvhe(__pkvm_pviommu_attach, dev->kvm, fd);
+	if (ret)
+		goto out_put_fd;
+
+	pviommu->fd = fd;
+	fd_install(fd, file);
+
+	return fd;
+
+out_put_fd:
+	put_unused_fd(fd);
+out_fput:
+	fput(file);
+	return ret;
+out_put_kvm:
+	kvm_put_kvm(dev->kvm);
+	kfree(pviommu);
+	return ret;
+}
