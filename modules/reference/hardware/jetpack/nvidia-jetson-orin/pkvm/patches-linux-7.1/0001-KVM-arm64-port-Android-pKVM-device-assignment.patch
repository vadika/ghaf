+void pkvm_device_request_power_pvm_entry(struct pkvm_hyp_vcpu *hyp_vcpu);
+void pkvm_devices_teardown(struct pkvm_hyp_vm *vm);
+int pkvm_device_register_ops(u64 phys, struct pkvm_device_ops *ops,
+			     void *cookie);
