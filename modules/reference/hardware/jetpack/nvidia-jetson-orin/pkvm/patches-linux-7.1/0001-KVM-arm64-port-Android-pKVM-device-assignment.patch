+struct kvm_hyp_req *pkvm_hyp_req_reserve(struct pkvm_hyp_vcpu *hyp_vcpu,
+					  u8 type)
+{
+	struct kvm_hyp_req *next;
+	struct kvm_hyp_req *hyp_req = hyp_vcpu->vcpu.arch.hyp_reqs;
+	int i;
+
+	if (!hyp_req)
